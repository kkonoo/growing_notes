{
  "name": "growing-notes-tests",
  "private": true,
  "description": "성장노트 테스트 전용 (앱 자체는 빌드·npm 없이 돌아가요)",
  "type": "module",
  "scripts": {
    "test": "npm run test:logic && npm run test:rules",
    "test:logic": "node --test tests/logic.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-growing \"node --test tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-growing \"node --test --test-concurrency=1 tests/e2e/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0",
    "playwright": "1.56.1"
  }
}
